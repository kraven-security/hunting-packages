title: Evilginx BigBear Session Cookies
id: 0b8d50f4-fc0f-4ef5-9001
status: stable
description: Detects known Evilginx and BigBear session cookies.
logsource:
  category: webserver
detection:
  selection:
    http_cookie|contains:
      - "evginx_session"
      - "bigbear_session"
      - "evginx_admin"
  condition: selection
falsepositives:
  - Unknown
level: high
tags:
  - attack.credential-access

