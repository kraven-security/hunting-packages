title: Telegram Credential Exfiltration
id: 0b8d50f4-fc0f-4ef5-9004
status: experimental
logsource:
  category: proxy
detection:
  telegram:
    url|contains: "api.telegram.org"
  methods:
    url|contains:
      - "/sendMessage"
      - "/sendDocument"
  secrets:
    http_request_body|contains:
      - "cookie"
      - "session"
      - "password"
      - "credential"
  condition: telegram and methods and 1 of secrets
falsepositives:
  - Approved Telegram automation
level: critical
tags:
  - attack.exfiltration

